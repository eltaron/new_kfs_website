APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# SECURITY: APP_DEBUG must be false in production (it leaks stack traces, env and SQL).
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# SECURITY: set to true in production (HTTPS only cookies).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# e-Finance unified payments (App\Services\Payments). Ask e-Finance for the
# production values; the gateway refuses to start a payment while any is empty.
# Test gateway URL: https://test-payment.efinance.com.eg/CardPaymentRequestIntiation/index
EFINANCE_DRIVER=efinance
EFINANCE_SENDER_ID=
EFINANCE_SENDER_NAME="محافظة كفر الشيخ"
EFINANCE_PASSWORD=
EFINANCE_SERVICE_CODE=
EFINANCE_SETTLEMENT_CODE=
EFINANCE_GATEWAY_URL=
EFINANCE_CERTIFICATE_PATH=
EFINANCE_SERVER_IP=
EFINANCE_EXPIRY_HOURS=24

# --- Security hardening (config/security.php) ---
# Comma-separated reverse-proxy IPs/CIDRs (or *) so HTTPS/client IP are detected correctly.
TRUSTED_PROXIES=
# Block login for citizen accounts still pending admin approval.
AUTH_BLOCK_PENDING_LOGIN=true
# Google Authenticator (2FA)
TWO_FACTOR_ISSUER="محافظة كفر الشيخ"
# Require 2FA for all staff (non-citizen roles) in the Filament panels.
TWO_FACTOR_REQUIRE_FOR_STAFF=false
# Security headers / Content-Security-Policy (Report-Only until CSP_ENFORCE=true)
SECURITY_HEADERS_ENABLED=true
CSP_ENFORCE=false
CSP_REPORT_URI=

# --- Demo data (database/seeders) ---
# Never true in production: demo seeders create accounts with a shared password.
ALLOW_DEMO_SEED=false
# Password for demo accounts; leave empty to generate a random one per run.
DEMO_PASSWORD=

# --- Engineers' syndicate module (modules/Syndicate/config) ---
# SECURITY: restrict the integration API to the syndicate's server IPs/CIDRs.
# Empty = any IP (a valid Sanctum token with the "syndicate" ability is still required).
SYNDICATE_API_ALLOWED_IPS=
SYNDICATE_API_RATE_LIMIT=60
SYNDICATE_API_IDEMPOTENCY_TTL=24
# Request/response bodies (national IDs) are stored in the API audit log when true.
SYNDICATE_API_LOG_BODIES=false
SYNDICATE_NOTIFY_MAIL=true
SYNDICATE_NOTIFY_SMS=true
SYNDICATE_NOTIFY_WEBPUSH=true
SYNDICATE_SMS_DRIVER=log
SYNDICATE_COUNCIL_EMAILS=
SYNDICATE_WEBHOOK_ENABLED=false
SYNDICATE_WEBHOOK_URL=
SYNDICATE_WEBHOOK_SECRET=
SYNDICATE_WEBHOOK_TIMEOUT=10

# --- Marketplace module (modules/Marketplace/config) ---
MARKET_DEFAULT_COMMISSION=0
MARKET_SHIPPING_FEE_PER_VENDOR=0
MARKET_COD_ENABLED=false
MARKET_RESERVATION_MINUTES=60

# --- Web push (VAPID) ---
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
